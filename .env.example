# Qloo Agentic Hackathon API key (requested via docs form; arrives by email)
# Never commit real keys. Paste into .env.local for local, or Vercel env for deploy.
QLOO_API_KEY=

# Optional override — default is the hackathon base URL.
# Hackathon keys ONLY work against hackathon.api.qloo.com (not staging/production).
QLOO_BASE_URL=https://hackathon.api.qloo.com
